model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    profile       String?
    phone         String?
    password      String
    isVerified    Boolean   @default(false)
    status        AllStatus @default(PENDING)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
}
